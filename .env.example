# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Legacy projects may set SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# SUPABASE_SERVICE_ROLE_KEY=replace_only_for_legacy_projects

# Kora Checkout Redirect. The public key is optional for this server-side flow.
KORA_PUBLIC_KEY=pk_live_replace_me
KORA_SECRET_KEY=sk_live_replace_me
KORA_ENVIRONMENT=live
KORA_WEBHOOK_REQUIRED=true

# Exact local, preview, or production origin. Do not include a trailing path.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only by the deliberate npm run admin:bootstrap command.
INITIAL_ADMIN_EMAIL=martinzkizitto@gmail.com

# Optional server-only Google Analytics Data API access for admin visitor metrics.
GOOGLE_ANALYTICS_PROPERTY_ID=123456789
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_EMAIL=analytics-reader@your-project.iam.gserviceaccount.com
GOOGLE_ANALYTICS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----\\n"
# Optional reporting start date in YYYY-MM-DD format. Defaults to this feature's launch date.
GOOGLE_ANALYTICS_VISITOR_START_DATE=2026-08-04
